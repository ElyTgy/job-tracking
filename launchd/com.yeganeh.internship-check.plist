<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yeganeh.internship-check</string>
  <!-- Fires daily at 10:00; run_check's 40h guard turns that into every other
       day and makes missed days (Mac asleep) catch up on the next fire. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/yeganeh/Documents/job-tracking</string>
  <!-- The shell appends to the log files itself; no StandardOutPath/StandardErrorPath.
       launchd opens those paths before spawning, and once a log file picks up a
       com.apple.macl privacy tag (it did in Sep 2026, after being opened from an app)
       that open fails and every fire dies with exit 78 (EX_CONFIG) and no output. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd /Users/yeganeh/Documents/job-tracking &amp;&amp; { .venv/bin/python -m scraper.run_check; .venv/bin/python -m scraper.notify; .venv/bin/python -m scraper.followups; } >> logs/check.log 2>> logs/check.err.log</string>
  </array>
</dict>
</plist>

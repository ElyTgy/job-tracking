# Gmail digest (scraper/notify.py)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Hosted DB (Turso). When set, both the scraper and the board use it instead of data/tracker.db.
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Password for the deployed board (HTTP Basic; any username). Set this on Vercel too.
BOARD_PASSWORD=
